{
  // Name shown in VS Code when the container is running
  "name": "atrey-dev",

  // Base image: Microsoft's universal devcontainer image on Ubuntu LTS.
  // It comes with common runtimes pre-installed and is well-maintained.
  // See: https://github.com/devcontainers/images/tree/main/src/universal
  "image": "mcr.microsoft.com/devcontainers/universal:2-linux",

  // Features are pre-built, composable add-ons for devcontainers.
  // Each block adds a specific tool or runtime to the container.
  // See the full list at: https://containers.dev/features
  "features": {
    // Node.js LTS — JavaScript runtime and npm
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts",
      "nodeGypDependencies": false
    },

    // Python 3 — latest stable Python runtime
    "ghcr.io/devcontainers/features/python:1": {
      "version": "os-provided",
      "installTools": false
    },

    // GitHub CLI (gh) — interact with GitHub from the terminal
    "ghcr.io/devcontainers/features/github-cli:1": {
      "version": "latest"
    },

    // Common utilities: zsh, fzf, jq, tree, unzip, make, and more
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "configureZshAsDefaultShell": true,
      "installOhMyZsh": false,
      "upgradePackages": false
    }
  },

  // Commands to run once inside the container after it is created.
  // This installs additional tools not available as official features.
  "postCreateCommand": "bash .devcontainer/post-create.sh",

  // Default shell for the integrated terminal — zsh
  "remoteEnv": {
    "SHELL": "/bin/zsh"
  },

  // VS Code settings applied inside this container
  "customizations": {
    "vscode": {
      "settings": {
        // Use the container's default shell (zsh) in the terminal
        "terminal.integrated.defaultProfile.linux": "zsh",

        // Prettier as the default formatter
        "editor.defaultFormatter": "esbenp.prettier-vscode",

        // Auto-format on save
        "editor.formatOnSave": true,

        // Show rulers at 80 and 120 characters
        "editor.rulers": [80, 120],

        // ESLint auto-fix on save
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "explicit"
        },

        // Prettier config
        "prettier.singleQuote": true,
        "prettier.semi": true,
        "prettier.trailingComma": "es5",

        // Use pnpm for Node package management
        "npm.packageManager": "pnpm"
      },

      // Extensions to install automatically when the container starts.
      // These are the extension IDs from the VS Code Marketplace.
      "extensions": [
        // AI code completions
        "GitHub.copilot",

        // AI chat assistant
        "GitHub.copilot-chat",

        // Opinionated code formatter
        "esbenp.prettier-vscode",

        // JavaScript/TypeScript linting
        "dbaeumer.vscode-eslint",

        // Python language support, IntelliSense, debugging
        "ms-python.python",

        // Markdown editing, preview, keyboard shortcuts
        "yzhang.markdown-all-in-one"
      ]
    }
  }
}
